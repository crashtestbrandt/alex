; Engine configuration file.
; Comment this file with `;` only. Godot's parser swallows a `#` block into the next key's name, and the setting
; under it silently never applies.

config_version=5

[alex]

; The release label and build number the profile picker shows (BuildStamp). tools/export.sh stamps both for the
; length of an export; a run from the editor shows "dev".
build/label="dev"
build/number=0

[application]

config/name="Alex"
config/description="A configurable companion for children who acquire language in gestalts."
; The version every export preset reports (docs/exports.md). The iOS build number comes from the archive step.
config/version="0.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
; The exploration mark appears only while loading, with no artificial delay.
boot_splash/show_image=true
boot_splash/image="res://assets/brand/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.97, 0.96, 0.93, 1)
config/icon="res://assets/brand/icon.png"
config/macos_native_icon="res://assets/brand/icon.icns"
config/windows_native_icon="res://assets/brand/icon.ico"

[audio]

; The microphone, for the caregiver's recording flow (Recorder). Off by default in Godot.
driver/enable_input=true
; Text to speech is the fallback voice for a gestalt with no recording. The OS voice is never the goal; a
; familiar adult's recording is. Off by default in Godot, so it is pinned on here.
general/text_to_speech=true
; iOS records only under the Play and Record session category (2). The default, Ambient, has no microphone
; and is muted by the phone's silent switch.
general/ios/session_category=2

[autoload]

App="*res://scripts/app.gd"
Style="*res://scripts/style/style.gd"
ProfileStore="*res://scripts/profiles/profile_store.gd"

[debug]

; Strict typing, promoted to errors. Every var, parameter and return carries a type; see CLAUDE.md.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
; Vendored code under addons/ is held to its own standard, first-party code to this one.
gdscript/warnings/exclude_addons=true

[gui]

; Text is a distance field too: the default font renders as multichannel SDF (docs/ui.md).
theme/default_font_multichannel_signed_distance_field=true
; A scroll begins after the room's DRAG_PX, so a resting finger's jitter keeps a hold (#39).
common/default_scroll_deadzone=24

[display]

; Main adapts the canvas to the window. Tablets start in landscape; handhelds may rotate.
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

; Touch is the real input. Mouse emulates it on a desktop so the app is developed on one.
pointing/emulate_touch_from_mouse=true

[rendering]

; Mobile renderer on every platform: 3D and motion graphics stay available, and phones and tablets are the
; targets.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; PCF filtering also applies on tablets, where Godot otherwise uses hard shadows.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=3
; Android and iOS need ETC2/ASTC textures, and an Android export refuses to start without them.
textures/vram_compression/import_etc2_astc=true
